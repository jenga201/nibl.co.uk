# Copy to .env. Never commit .env.
# Optional: host port for local HTTP access, default 8080
NIBLCOUK_HTTP_PORT=8080

# Required: Laravel application key.
# Generate with: openssl rand -base64 32  ->  NIBLCOUK_APP_KEY=base64:<output>
NIBLCOUK_APP_KEY=

# Optional overrides (defaults shown)
#NIBLCOUK_APP_URL=https://www.nibl.co.uk
#NIBLCOUK_DATA_CACHE=apcu
#NIBLCOUK_LOG_LEVEL=info
